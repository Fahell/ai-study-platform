{
  "name": "fullstack-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@fullstack/backend",
    "dev:frontend": "turbo dev --filter=@fullstack/frontend",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules .turbo",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @fullstack/db db:generate",
    "db:migrate": "pnpm --filter @fullstack/db db:migrate",
    "db:push": "pnpm --filter @fullstack/db db:push",
    "db:studio": "pnpm --filter @fullstack/db db:studio"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "turbo": "^2.4.0"
  }
}
